{
  "name": "@galaxy-stack/orbit-common",
  "version": "0.1.13",
  "description": "Common decorators, pipes, guards, interceptors for Orbit",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --packages external",
    "dev": "bun --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build:types": "bash ../../scripts/build-types.sh common"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.0.0"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galaxy-orbit/orbit.git",
    "directory": "packages/common"
  },
  "homepage": "https://github.com/galaxy-orbit/orbit#readme",
  "bugs": {
    "url": "https://github.com/galaxy-orbit/orbit/issues"
  }
}
