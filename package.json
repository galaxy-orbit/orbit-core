{
  "name": "@galaxy-stack/orbit-core",
  "version": "0.1.9",
  "description": "Core framework for Orbit - DI Container, Module System, Router",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./container": {
      "import": "./dist/container/index.js",
      "types": "./dist/container/index.d.ts"
    },
    "./metadata": {
      "import": "./dist/metadata/index.js",
      "types": "./dist/metadata/index.d.ts"
    }
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --external reflect-metadata --external @galaxy-stack/orbit-common",
    "dev": "bun --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build:types": "bash ../../scripts/build-types.sh core",
    "changeset": "changeset"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.0",
    "@galaxy-stack/orbit-common": "^0.1.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.0.0",
    "reflect-metadata": "^0.2.2",
    "@changesets/cli": "^2.27.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galaxy-orbit/orbit-core.git"
  },
  "homepage": "https://github.com/galaxy-orbit/orbit#readme",
  "bugs": {
    "url": "https://github.com/galaxy-orbit/orbit-core/issues"
  }
}
